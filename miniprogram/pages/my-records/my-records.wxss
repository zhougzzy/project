/* pages/my-records/my-records.wxss */
page {
  background-color: #f6f7f8;
  padding: 30rpx;
  box-sizing: border-box;
}

.header {
  margin-bottom: 40rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.empty-text {
  text-align: center;
  color: #999;
  margin-top: 100rpx;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.record-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
  padding-bottom: 20rpx;
}

.month-tag {
  font-size: 24rpx;
  color: #108ee9;
  background-color: rgba(16, 142, 233, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.card-body {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.label {
  font-size: 28rpx;
  color: #666;
}

.value {
  font-size: 28rpx;
  color: #333;
}

.value.highlight {
  font-size: 32rpx;
  font-weight: bold;
  color: #07C160;
}

.value.date {
  color: #999;
  font-size: 24rpx;
}

/* 多工地样式 */
.project-entry {
  background-color: #f9fafb;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.project-name-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.project-name-row .label {
  font-weight: bold;
  color: #333;
}

.project-name-row .value {
  font-weight: 500;
  color: #1e293b;
}

.total-row {
  border-top: 1rpx dashed #e2e8f0;
  padding-top: 16rpx;
  margin-top: 8rpx;
}

.total-row .label {
  font-weight: bold;
  color: #333;
}
