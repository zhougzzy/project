/* pages/bind-account/bind-account.wxss */
.header-bg {
  background: linear-gradient(135deg, #0EA5E9 0%, #0284C7 100%);
  padding: 60rpx 40rpx 100rpx;
}

.text-3xl {
  font-size: 48rpx;
}

.text-6xl {
  font-size: 96rpx;
}

.bg-primary {
  background-color: #0EA5E9;
}

.text-white {
  color: #ffffff;
}

.bg-blue-50 {
  background-color: rgba(14, 165, 233, 0.1);
}

.text-blue-500 {
  color: #0EA5E9;
}

.text-blue-600 {
  color: #0284C7;
}

.bg-white {
  background-color: #ffffff;
}

.content {
  margin-top: -60rpx;
}

.empty-card {
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.tip-card {
  border: 1rpx solid rgba(14, 165, 233, 0.2);
}

.worker-list {
  margin-bottom: 40rpx;
}

.worker-item {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  border: 4rpx solid transparent;
  transition: all 0.2s;
}

.worker-item.selected {
  border-color: #0EA5E9;
  background-color: rgba(14, 165, 233, 0.05);
}

.worker-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 800;
  margin-right: 24rpx;
}

.worker-info {
  flex: 1;
}

.check-icon {
  width: 48rpx;
  height: 48rpx;
  background-color: #0EA5E9;
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
}

.bind-btn {
  width: 100%;
  padding: 28rpx 0;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 700;
  border: none;
}

.bind-btn[disabled] {
  opacity: 0.5;
}
