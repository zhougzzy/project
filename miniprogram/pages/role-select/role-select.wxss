/* pages/role-select/role-select.wxss */
page {
  height: 100%;
}

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #EFF6FF 0%, #DBEAFE 50%, #BFDBFE 100%);
  position: relative;
  overflow: hidden;
}

/* 加载动画样式 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #E2E8F0;
  border-top-color: #3B82F6;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #64748B;
}

/* 顶部装饰 */
.top-decoration {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 400rpx;
  overflow: hidden;
}

.decoration-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.3;
}

.decoration-circle-1 {
  width: 400rpx;
  height: 400rpx;
  background: #3B82F6;
  top: -100rpx;
  right: -100rpx;
}

.decoration-circle-2 {
  width: 300rpx;
  height: 300rpx;
  background: #8B5CF6;
  top: 50rpx;
  left: -50rpx;
}

.decoration-circle-3 {
  width: 200rpx;
  height: 200rpx;
  background: #06B6D4;
  bottom: 20rpx;
  right: 100rpx;
}

/* Logo区域 */
.logo-section {
  position: relative;
  z-index: 1;
  padding-top: 100rpx;
  padding-bottom: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo-wrapper {
  width: 180rpx;
  height: 180rpx;
  background: linear-gradient(135deg, #3B82F6 0%, #8B5CF6 100%);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  box-shadow: 0 16rpx 48rpx rgba(59, 130, 246, 0.4);
}

.logo-icon {
  font-size: 88rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: 800;
  color: #1E293B;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.app-slogan {
  font-size: 26rpx;
  color: #64748B;
  letter-spacing: 4rpx;
}

/* 角色选择区域 */
.role-section {
  position: relative;
  z-index: 1;
  padding: 40rpx 32rpx;
}

.section-title {
  font-size: 30rpx;
  color: #64748B;
  text-align: center;
  margin-bottom: 40rpx;
  letter-spacing: 2rpx;
}

.role-cards {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.role-card {
  background: #ffffff;
  backdrop-filter: blur(20rpx);
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid #E2E8F0;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.role-card:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.role-card-admin {
  border-left: 6rpx solid #FCD34D;
}

.role-card-worker {
  border-left: 6rpx solid #34D399;
}

.card-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.card-icon-wrapper {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.card-icon-admin {
  background: linear-gradient(135deg, #FCD34D 0%, #F59E0B 100%);
}

.card-icon-worker {
  background: linear-gradient(135deg, #34D399 0%, #10B981 100%);
}

.card-icon {
  font-size: 48rpx;
}

.card-info {
  flex: 1;
}

.card-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1E293B;
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #64748B;
}

.card-arrow {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow-icon {
  font-size: 36rpx;
  color: #94A3B8;
}

/* 底部版权 */
.footer {
  position: relative;
  z-index: 1;
  padding: 40rpx 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

.footer-text {
  font-size: 22rpx;
  color: #94A3B8;
}

.footer-link {
  font-size: 22rpx;
  color: #3B82F6;
  margin-left: 8rpx;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(8rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.modal-content {
  width: 620rpx;
  background: #ffffff;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.15);
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { 
    opacity: 0;
    transform: translateY(40rpx);
  }
  to { 
    opacity: 1;
    transform: translateY(0);
  }
}

.modal-header {
  padding: 48rpx 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-bottom: 1rpx solid #E2E8F0;
}

.modal-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-bottom: 20rpx;
}

.modal-icon-admin {
  background: linear-gradient(135deg, #FCD34D 0%, #F59E0B 100%);
}

.modal-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1E293B;
}

.modal-body {
  padding: 40rpx;
}

.input-label {
  font-size: 26rpx;
  color: #64748B;
  margin-bottom: 16rpx;
}

.input-wrapper {
  position: relative;
}

.code-input {
  width: 100%;
  height: 96rpx;
  background: #F1F5F9;
  border-radius: 20rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: #1E293B;
  box-sizing: border-box;
  border: 2rpx solid #E2E8F0;
  transition: all 0.3s ease;
}

.code-input:focus {
  border-color: #3B82F6;
  background: rgba(59, 130, 246, 0.1);
}

.placeholder-style {
  color: #94A3B8;
}

.error-msg {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: rgba(239, 68, 68, 0.15);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid rgba(239, 68, 68, 0.3);
}

.error-icon {
  font-size: 24rpx;
  margin-right: 12rpx;
}

.error-text {
  font-size: 24rpx;
  color: #FCA5A5;
}

.modal-footer {
  padding: 24rpx 40rpx 40rpx;
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.modal-btn-cancel {
  background: #F1F5F9;
  color: #64748B;
}

.modal-btn-cancel:active {
  background: #E2E8F0;
}

.modal-btn-confirm {
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  color: #ffffff;
}

.modal-btn-confirm:active:not([disabled]) {
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
}

.modal-btn[disabled] {
  opacity: 0.5;
}
