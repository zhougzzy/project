.container {
  min-height: 100vh;
  background-color: #f6f7f8;
  padding-bottom: env(safe-area-inset-bottom);
}

.header {
  background-color: #ffffff;
  padding: 32rpx;
  border-bottom: 1rpx solid #e2e8f0;
  position: sticky;
  top: 0;
  z-index: 10;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 900;
  color: #0f172a;
}

.export-btn {
  padding: 12rpx 24rpx;
  background-color: #f1f5f9;
  border-radius: 32rpx;
}

.export-text {
  font-size: 24rpx;
  color: #475569;
  font-weight: 700;
}

.search-box {
  display: flex;
  align-items: center;
  background-color: #f1f5f9;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  margin-bottom: 32rpx;
}

.search-input {
  flex: 1;
  margin-left: 16rpx;
  font-size: 28rpx;
  color: #0f172a;
}

.filter-tabs {
  white-space: nowrap;
  width: 100%;
}

.tab {
  display: inline-block;
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #475569;
  background-color: #f1f5f9;
  margin-right: 16rpx;
  transition: all 0.2s;
}

.active-all { background-color: #1e293b; color: #ffffff; }
.active-linked { background-color: #dcfce7; color: #15803d; }
.active-unlinked { background-color: #fef3c7; color: #b45309; }

.list-container {
  padding: 32rpx;
}

.worker-card {
  background-color: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.02);
}

.card-top {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background-color: rgba(15, 23, 42, 0.1);
  color: #0f172a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 900;
  margin-right: 24rpx;
}

.info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.name {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.team {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 8rpx;
}

.status {
  font-size: 20rpx;
  font-weight: 700;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.status-linked { background-color: #dcfce7; color: #15803d; }
.status-unlinked { background-color: #fef3c7; color: #b45309; }

.card-bottom {
  display: flex;
  gap: 16rpx;
  border-top: 1rpx solid #f1f5f9;
  padding-top: 24rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.btn-detail { background-color: #f8fafc; color: #475569; }
.btn-invite { background-color: rgba(15, 23, 42, 0.05); color: #0f172a; }

.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #94a3b8;
  font-weight: 500;
}

.fab {
  position: fixed;
  right: 48rpx;
  bottom: 160rpx; /* 避开底部导航栏 */
  width: 112rpx;
  height: 112rpx;
  background-color: #0f172a;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.3);
  z-index: 20;
}

.fab-icon {
  color: #ffffff;
  font-size: 64rpx;
  font-weight: 300;
  margin-top: -8rpx;
}