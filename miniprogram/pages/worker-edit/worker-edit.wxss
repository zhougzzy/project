/* pages/worker-edit/worker-edit.wxss */
.container {
  min-height: 100vh;
  background-color: #f8fafc;
}

.header-bg {
  background: linear-gradient(135deg, #0EA5E9 0%, #0284C7 100%);
  padding: 60rpx 40rpx 80rpx;
}

.text-2xl {
  font-size: 36rpx;
}

.text-sm {
  font-size: 26rpx;
}

.font-black {
  font-weight: 900;
}

.text-white {
  color: #ffffff;
}

.opacity-80 {
  opacity: 0.8;
}

.mt-2 {
  margin-top: 16rpx;
}

.form-card {
  margin: -40rpx 32rpx 0;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.form-item {
  margin-bottom: 40rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #374151;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #1f2937;
  border: 1rpx solid #e2e8f0;
}

.form-input:focus {
  border-color: #0EA5E9;
}

.picker-display {
  width: 100%;
  height: 88rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #1f2937;
  border: 1rpx solid #e2e8f0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-display .arrow {
  font-size: 32rpx;
  color: #94a3b8;
  font-weight: 300;
}

.btn-wrap {
  padding: 60rpx 32rpx;
}

.save-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #0EA5E9 0%, #0284C7 100%);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(14, 165, 233, 0.3);
}

.save-btn[disabled] {
  opacity: 0.6;
}

.save-btn::after {
  border: none;
}

/* 查看模式样式 */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #64748b;
}

.info-value {
  font-size: 30rpx;
  color: #1f2937;
  font-weight: 500;
}

/* 编辑按钮 */
.edit-btn {
  position: absolute;
  right: 32rpx;
  top: 60rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
}

.edit-btn text {
  color: #ffffff;
  font-size: 26rpx;
}
