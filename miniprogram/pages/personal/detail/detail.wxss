.container {
  min-height: 100vh;
  background-color: #f6f7f8;
  display: flex;
  flex-direction: column;
}

.header {
  background-color: #ffffff;
  padding: 32rpx;
  border-bottom: 1rpx solid #e2e8f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: sticky;
  top: 0;
  z-index: 10;
}

.title {
  font-size: 36rpx;
  font-weight: 900;
  color: #0f172a;
}

.header-right {
  display: flex;
  gap: 24rpx;
}

.action-text {
  font-size: 28rpx;
  font-weight: 700;
  padding: 8rpx;
}

.text-primary { color: #0f172a; }
.text-danger { color: #ef4444; }

.main-content {
  flex: 1;
}

.profile-header {
  background-color: #ffffff;
  padding: 48rpx 32rpx;
  border-bottom: 1rpx solid #e2e8f0;
}

.profile-top {
  display: flex;
  align-items: center;
  margin-bottom: 48rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: rgba(15, 23, 42, 0.1);
  color: #0f172a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 900;
  margin-right: 32rpx;
}

.info {
  flex: 1;
}

.name {
  font-size: 40rpx;
  font-weight: 900;
  color: #0f172a;
  display: block;
  margin-bottom: 8rpx;
}

.team {
  font-size: 26rpx;
  color: #64748b;
  display: block;
  margin-bottom: 16rpx;
}

/* 状态标签外层容器，用于控制对齐 */
.status-wrap {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

/* 状态标签外层容器 */
.status-wrap {
  display: flex;
  align-items: center;
  margin-top: 12rpx; /* 稍微增加一点与上方文字的间距 */
}

/* 状态标签外层容器 */
.status-wrap {
  display: flex;
  align-items: center;
  margin-top: 12rpx; 
}

/* 状态标签基础样式：绝对垂直居中方案 */
.status {
  display: inline-block;
  height: 36rpx;           /* 1. 明确指定标签的高度 */
  line-height: 36rpx;      /* 2. 行高与高度完全一致，实现绝对垂直居中 */
  padding: 0 16rpx;        /* 3. 取消上下 padding，只保留左右 padding */
  font-size: 20rpx;        /* 4. 字体大小 */
  font-weight: 700;
  border-radius: 8rpx;     /* 5. 圆角 */
  text-align: center;      /* 6. 水平居中 */
}

/* 已绑定微信：绿色背景，绿色文字 */
.status-linked { 
  background-color: #dcfce7; 
  color: #15803d; 
}

/* 未绑定：黄色/橙色背景，橙色文字 */
.status-unlinked { 
  background-color: #fef3c7; 
  color: #b45309; 
}
.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.info-item {
  background-color: #f8fafc;
  padding: 20rpx;
  border-radius: 20rpx;
  border: 1rpx solid #f1f5f9;
}

.info-label {
  display: block;
  font-size: 20rpx;
  font-weight: 700;
  color: #94a3b8;
  text-transform: uppercase;
  margin-bottom: 8rpx;
}

.info-value {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #334155;
}

.text-truncate {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stats-summary {
  padding: 32rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.stat-card {
  background-color: #ffffff;
  padding: 24rpx;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.02);
  border: 1rpx solid #e2e8f0;
}

.stat-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #94a3b8;
  text-transform: uppercase;
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: 900;
  margin-top: 12rpx;
}

.records-section {
  padding: 0 32rpx 32rpx;
}

.tabs {
  display: flex;
  border-bottom: 1rpx solid #e2e8f0;
  margin-bottom: 24rpx;
}

.tab {
  padding: 20rpx 32rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #94a3b8;
  position: relative;
}

.tab.active {
  color: #0f172a;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: -1rpx;
  left: 32rpx;
  right: 32rpx;
  height: 4rpx;
  background-color: #0f172a;
  border-radius: 4rpx;
}

.add-advance-btn {
  width: 100%;
  padding: 20rpx;
  border-radius: 20rpx;
  border: 4rpx dashed rgba(15, 23, 42, 0.2);
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  background-color: rgba(15, 23, 42, 0.02);
}

.add-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
  margin-top: -4rpx;
}

.record-item {
  background-color: #ffffff;
  padding: 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid #e2e8f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.record-remark {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 8rpx;
}

.record-meta {
  font-size: 22rpx;
  color: #64748b;
}

.record-amount {
  font-size: 32rpx;
  font-weight: 900;
  color: #0f172a;
}

.attendance-list {
  background-color: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #e2e8f0;
  overflow: hidden;
}

.attendance-item {
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f1f5f9;
}

.attendance-item:last-child {
  border-bottom: none;
}

.att-month {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 4rpx;
}

.att-project {
  display: block;
  font-size: 22rpx;
  color: #64748b;
}

.att-remark {
  display: block;
  font-size: 20rpx;
  color: #94a3b8;
  font-style: italic;
  margin-top: 8rpx;
}

.att-right {
  text-align: right;
}

.att-days {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 8rpx;
}

.att-status {
  font-size: 20rpx;
  font-weight: 700;
  color: #16a34a;
  text-transform: uppercase;
}

.loading, .empty-state {
  text-align: center;
  padding: 64rpx 0;
  color: #94a3b8;
  font-size: 26rpx;
}