.container {
  min-height: 100vh;
  background-color: #f6f7f8;
  display: flex;
  flex-direction: column;
}

.pb-safe {
  padding-bottom: env(safe-area-inset-bottom);
}

.header {
  background-color: #ffffff;
  padding: 32rpx 32rpx 16rpx;
}
.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #0f172a;
  text-align: center;
  display: block;
}
/* 搜索框 */
.search-container {
  padding: 24rpx 32rpx;
  background-color: #f6f7f8;
}

.search-bar {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  height: 96rpx;
  padding: 0 32rpx;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.02);
}

.search-input {
  flex: 1;
  margin-left: 16rpx;
  font-size: 28rpx;
  color: #0f172a;
  height: 100%;
}

.search-placeholder {
  color: #94a3b8;
}

/* 列表区域 */
.list-container {
  flex: 1;
  padding: 0 32rpx;
}

.project-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.02);
  border: 1rpx solid #f1f5f9;
}

.card-top {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.icon-box {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background-color: rgba(15, 23, 42, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 32rpx;
}

.info-box {
  flex: 1;
}

.project-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
  display: block;
  margin-bottom: 8rpx;
}

.status-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.date-text {
  font-size: 24rpx;
  color: #64748b;
}

/* 底部操作按钮 */
.card-actions {
  display: flex;
  gap: 16rpx;
  border-top: 1rpx solid #f8fafc;
  padding-top: 32rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f8fafc;
  padding: 16rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #334155;
}

.text-red {
  color: #dc2626;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 120rpx;
}

.empty-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #94a3b8;
}

/* 悬浮按钮 */
.fab {
  position: fixed;
  right: 48rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  background-color: #0f172a;
  border-radius: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.3);
  z-index: 20;
}

.fab-icon {
  color: #ffffff;
  font-size: 56rpx;
  font-weight: 300;
  margin-top: -8rpx;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(4px);
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}

.modal-content {
  background-color: #ffffff;
  border-radius: 32rpx;
  padding: 48rpx;
  width: 100%;
  max-width: 600rpx;
  box-shadow: 0 20rpx 50rpx rgba(0,0,0,0.1);
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #0f172a;
  display: block;
  margin-bottom: 32rpx;
}

.modal-input-group {
  margin-bottom: 32rpx;
}

.modal-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #64748b;
  margin-bottom: 16rpx;
  display: block;
}

.modal-input {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  padding: 0 32rpx;
  border-radius: 24rpx;
  border: 1rpx solid #e2e8f0;
  font-size: 32rpx;
  color: #0f172a;
  box-sizing: border-box;
}

.modal-info-group {
  background-color: #f8fafc;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 48rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-row {
  display: flex;
  font-size: 26rpx;
}

.info-label {
  color: #64748b;
  width: 140rpx;
}

.info-value {
  color: #334155;
  font-weight: 500;
}

.text-green {
  color: #15803d !important;
  font-weight: 700;
}

.text-gray {
  color: #94a3b8 !important;
}

.modal-btns {
  display: flex;
  gap: 24rpx;
}

.modal-btn {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
}

.btn-cancel {
  background-color: #f1f5f9;
  color: #64748b;
}

.btn-confirm {
  background-color: #0f172a;
  color: #ffffff;
}