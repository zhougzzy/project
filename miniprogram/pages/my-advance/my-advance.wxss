/* pages/my-advance/my-advance.wxss */
.container {
  min-height: 100vh;
  background-color: #f6f7f8;
  display: flex;
  flex-direction: column;
}
.pb-safe { padding-bottom: env(safe-area-inset-bottom); }

/* 顶部标题 */
.header {
  background-color: #ffffff;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  box-sizing: border-box;
  position: sticky;
  top: 0;
  z-index: 50;
}

.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #0f172a;
}

/* 筛选区 */
.filter-section {
  display: flex;
  background-color: #ffffff;
  padding: 24rpx 32rpx;
  gap: 16rpx;
  border-top: 1rpx solid #f1f5f9;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.02);
  z-index: 10;
}

.filter-item {
  flex: 1;
  background-color: #f8fafc;
  height: 72rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  transition: all 0.2s ease;
}

.filter-item:active {
  background-color: #e2e8f0;
  transform: scale(0.98);
}

.filter-text {
  font-size: 26rpx;
  color: #334155;
  font-weight: 500;
  max-width: 140rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.dropdown-icon {
  font-size: 20rpx;
  color: #94a3b8;
  margin-left: 8rpx;
}

/* 统计卡片区 */
.stats-section {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
}

.stat-card {
  flex: 1;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.stat-card:active {
  transform: scale(0.98);
}

.stat-primary {
  background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
}

.stat-success {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
}

.stat-icon {
  font-size: 44rpx;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(255,255,255,0.2);
  border-radius: 20rpx;
}

.stat-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  font-weight: 500;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 900;
  color: #ffffff;
  margin-top: 4rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e2e8f0;
  border-top-color: #0ea5e9;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #94a3b8;
  margin-top: 20rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #334155;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #94a3b8;
}

/* 列表容器 */
.list-container {
  flex: 1;
  padding: 0 32rpx 32rpx;
}

/* 月份分组标题 */
.month-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0 20rpx;
}

.month-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.month-total {
  font-size: 26rpx;
  font-weight: 600;
  color: #0ea5e9;
}

/* 借支卡片 */
.advance-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  position: relative;
  overflow: hidden;
}

.advance-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: linear-gradient(180deg, #0ea5e9 0%, #06b6d4 100%);
}

.advance-card:active {
  transform: scale(0.99);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.card-main {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.card-left {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.amount-wrapper {
  display: flex;
  align-items: baseline;
}

.amount-symbol {
  font-size: 26rpx;
  font-weight: 600;
  color: #dc2626;
}

.amount-value {
  font-size: 48rpx;
  font-weight: 900;
  color: #dc2626;
  line-height: 1;
}

.reason-tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  background-color: #f0f9ff;
  color: #0369a1;
  font-size: 22rpx;
  border-radius: 8rpx;
  width: fit-content;
}

.card-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.date-text {
  font-size: 24rpx;
  color: #64748b;
  font-weight: 500;
}

.method-tag {
  padding: 4rpx 12rpx;
  background-color: #f5f3ff;
  color: #7c3aed;
  font-size: 20rpx;
  border-radius: 6rpx;
}

.card-footer {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #e2e8f0;
}

.remark-text {
  font-size: 24rpx;
  color: #94a3b8;
}

/* 反馈按钮 */
.card-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f1f5f9;
}

.btn-question {
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  color: #ffffff;
  border: none;
  border-radius: 20rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 6rpx;
  line-height: 1.5;
  transition: all 0.2s ease;
}

.btn-question:active {
  transform: scale(0.95);
  opacity: 0.9;
}

.btn-icon {
  font-size: 22rpx;
}

/* 加载更多 */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
  font-size: 24rpx;
  color: #94a3b8;
}

.loading-more {
  color: #0ea5e9;
}

.loading-spinner-small {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #e2e8f0;
  border-top-color: #0ea5e9;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-right: 12rpx;
}

.no-more {
  color: #cbd5e1;
}

/* 筛选弹窗 */
.filter-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.filter-modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(4px);
}

.filter-modal-content {
  position: relative;
  width: 100%;
  background-color: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.filter-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.filter-modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.filter-modal-close {
  font-size: 32rpx;
  color: #94a3b8;
  padding: 8rpx;
}

.filter-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.filter-option {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  background-color: #f8fafc;
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.filter-option.active {
  background: linear-gradient(135deg, #e0f2fe 0%, #bae6fd 100%);
  border: 2rpx solid #0ea5e9;
}

.filter-option:active {
  transform: scale(0.99);
}

.filter-option text:first-child {
  font-size: 30rpx;
  color: #334155;
  font-weight: 500;
}

.filter-option.active text:first-child {
  color: #0369a1;
  font-weight: 600;
}

.filter-option-count {
  font-size: 24rpx;
  color: #94a3b8;
  background-color: #ffffff;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.filter-option.active .filter-option-count {
  background-color: rgba(14, 165, 233, 0.15);
  color: #0369a1;
}
