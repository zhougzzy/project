page {
  background-color: #f6f7f8;
}

.container {
  padding: 30rpx;
  padding-bottom: 180rpx; /* 留出底部 TabBar 的空间 */
}

/* 顶部卡片 */
.header-card {
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  border-radius: 24rpx;
  padding: 40rpx;
  color: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(37, 99, 235, 0.2);
  margin-bottom: 40rpx;
}

.title {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 16rpx;
}

.amount {
  font-size: 64rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.stats {
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.2);
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
}

/* 按钮区 */
.action-section {
  margin-bottom: 40rpx;
}

.btn-primary {
  background-color: #2563eb;
  color: white;
  border-radius: 20rpx;
  padding: 24rpx 0;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(37, 99, 235, 0.2);
}

.btn-primary:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.btn-primary .icon {
  font-size: 40rpx;
  margin-right: 12rpx;
  font-weight: normal;
  line-height: 1;
}

/* 列表区 */
.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.list-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1e293b;
}

.list-more {
  font-size: 26rpx;
  color: #64748b;
}

.record-item {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.02);
}

.record-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #0f172a;
  margin-bottom: 8rpx;
}

.record-desc {
  font-size: 24rpx;
  color: #64748b;
}

.record-right {
  text-align: right;
}

.record-amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #2563eb;
}

.record-remark {
  font-size: 24rpx;
  color: #94a3b8;
  margin-top: 8rpx;
}

.empty-state {
  text-align: center;
  padding: 60rpx 0;
  color: #94a3b8;
  font-size: 28rpx;
}
/* 搜索框 */
.search-bar {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  border: 2rpx solid #e2e8f0;
}
.search-bar input {
  flex: 1;
  margin-left: 16rpx;
  font-size: 28rpx;
}

/* 列表项调整 */
.record-item {
  flex-direction: column;
  align-items: stretch;
}
.record-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.record-images {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed #f1f5f9;
}
.thumb {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  background: #f8fafc;
}

/* 员工端借支卡片样式 */
.total-card {
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  border-radius: 24rpx;
  padding: 40rpx;
  color: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(37, 99, 235, 0.2);
}

.advance-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.02);
}

/* 详情弹窗样式 */
.detail-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4px);
  z-index: 100;
  animation: fadeIn 0.2s ease-out;
}

.detail-modal {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 101;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.3s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.detail-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 2rpx solid #f1f5f9;
}

.detail-modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #0f172a;
}

.detail-modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f8fafc;
  border-radius: 50%;
}

.detail-modal-close text {
  font-size: 28rpx;
  color: #64748b;
}

.detail-modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 32rpx;
}

.detail-section {
  margin-bottom: 32rpx;
}

.detail-worker {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  padding: 24rpx;
  border-radius: 20rpx;
}

.detail-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
}

.detail-worker-info {
  display: flex;
  flex-direction: column;
}

.detail-worker-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.detail-worker-id {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 4rpx;
}

.detail-amount-section {
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
  border-radius: 20rpx;
  padding: 32rpx;
  text-align: center;
  margin-bottom: 32rpx;
}

.detail-amount-label {
  font-size: 24rpx;
  color: #92400e;
  display: block;
  margin-bottom: 8rpx;
}

.detail-amount-value {
  font-size: 56rpx;
  font-weight: 900;
  color: #dc2626;
}

.detail-amount-edit {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
}

.amount-prefix {
  font-size: 36rpx;
  font-weight: 700;
  color: #dc2626;
  margin-right: 8rpx;
}

.amount-input {
  font-size: 48rpx;
  font-weight: 900;
  color: #dc2626;
  text-align: center;
  min-width: 300rpx;
  max-width: 500rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
}

.detail-edit-picker {
  font-size: 28rpx;
  color: #334155;
  background: #f8fafc;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  border: 2rpx solid #e2e8f0;
  min-width: 200rpx;
  text-align: center;
}

.detail-edit-textarea {
  font-size: 28rpx;
  color: #334155;
  background: #f8fafc;
  padding: 16rpx;
  border-radius: 12rpx;
  border: 2rpx solid #e2e8f0;
  min-height: 100rpx;
  width: 100%;
  box-sizing: border-box;
}

.detail-info-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.detail-info-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f8fafc;
}

.detail-info-item:last-child {
  border-bottom: none;
}

.detail-info-label {
  font-size: 26rpx;
  color: #64748b;
  flex-shrink: 0;
  width: 140rpx;
}

.detail-info-value {
  font-size: 28rpx;
  color: #0f172a;
  text-align: right;
  flex: 1;
  margin-left: 24rpx;
}

.detail-images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  flex: 1;
  margin-left: 24rpx;
}

.detail-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #f8fafc;
}

.detail-modal-footer {
  display: flex;
  gap: 24rpx;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #f1f5f9;
  background: #ffffff;
}

.detail-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}

.detail-btn-primary {
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(37, 99, 235, 0.3);
}

.detail-btn-primary:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.detail-btn-delete {
  background: #fee2e2;
  color: #dc2626;
  border: 2rpx solid #fecaca;
}

.detail-btn-delete:active {
  background: #fecaca;
}

.detail-btn-edit {
  background: #fef3c7;
  color: #d97706;
  border: 2rpx solid #fde68a;
  margin-right: 20rpx;
}

.detail-btn-cancel {
  background: #f1f5f9;
  color: #64748b;
  border: 2rpx solid #e2e8f0;
  margin-right: 20rpx;
}