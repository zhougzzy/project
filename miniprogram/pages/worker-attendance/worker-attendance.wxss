/* pages/worker-attendance/worker-attendance.wxss */
page {
  background-color: #f5f7fa;
}

.container {
  min-height: 100vh;
  padding-bottom: 180rpx;
}

/* 头部区域 */
.header {
  background: linear-gradient(135deg, #1e40af 0%, #3b82f6 50%, #0ea5e9 100%);
  padding: 32rpx;
  padding-top: 24rpx;
}

.header-content {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.header-icon {
  width: 88rpx;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  backdrop-filter: blur(10rpx);
}

.header-text {
  display: flex;
  flex-direction: column;
}

.page-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 1rpx;
}

.page-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

/* 月份选择器 */
.month-picker {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 40rpx;
  backdrop-filter: blur(10rpx);
}

.month-text {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 600;
}

.picker-arrow {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 已提交提示 */
.submitted-tip {
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  color: #92400e;
  padding: 20rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  margin: 24rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.submitted-tip::before {
  content: '⏰';
}

/* 内容区域 */
.content {
  padding: 24rpx;
}

/* 员工信息卡片 */
.info-card {
  background: linear-gradient(135deg, #ffffff, #f8fafc);
  border-radius: 24rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid #f1f5f9;
  margin-bottom: 24rpx;
}

.info-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #3b82f6, #1d4ed8);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.3);
}

.info-content {
  flex: 1;
  margin-left: 24rpx;
}

.info-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1e293b;
}

.info-team {
  font-size: 26rpx;
  color: #64748b;
  margin-top: 6rpx;
}

.info-badge {
  background: linear-gradient(135deg, #dbeafe, #bfdbfe);
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
}

.badge-text {
  font-size: 22rpx;
  color: #1d4ed8;
  font-weight: 600;
}

/* 统计卡片 */
.stats-card {
  background: linear-gradient(135deg, #3b82f6, #1d4ed8);
  border-radius: 20rpx;
  padding: 28rpx 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(29, 78, 216, 0.3);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 48rpx;
  font-weight: 800;
  color: #ffffff;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 4rpx;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* 区块标题 */
.section-title {
  display: flex;
  align-items: baseline;
  margin-bottom: 20rpx;
  gap: 12rpx;
}

.title-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
}

.title-hint {
  font-size: 24rpx;
  color: #94a3b8;
}

/* 工地卡片列表 */
.project-list {
  margin-bottom: 160rpx;
}

/* 工地卡片 */
.project-card {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid #f1f5f9;
  transition: all 0.3s ease;
  margin-bottom: 20rpx;
}

.project-card.active {
  border-color: #3b82f6;
  box-shadow: 0 8rpx 32rpx rgba(59, 130, 246, 0.15);
}

/* 卡片头部 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
}

.project-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

/* 复选框 */
.checkbox {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  border: 3rpx solid #cbd5e1;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.checkbox.checked {
  background: linear-gradient(135deg, #3b82f6, #1d4ed8);
  border-color: #3b82f6;
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.4);
}

.checkbox text {
  color: white;
  font-size: 26rpx;
  font-weight: bold;
}

.project-details {
  display: flex;
  flex-direction: column;
}

.project-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
}

.project-location {
  font-size: 24rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

/* 天数显示 */
.days-display {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  background: linear-gradient(135deg, #3b82f6, #1d4ed8);
  padding: 14rpx 24rpx;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(29, 78, 216, 0.3);
}

.days-display.inactive {
  background: linear-gradient(135deg, #f1f5f9, #e2e8f0);
}

.days-display.inactive .days-num,
.days-display.inactive .days-unit {
  color: #94a3b8;
}

.days-num {
  font-size: 36rpx;
  font-weight: 800;
  color: white;
}

.days-unit {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 卡片内容区域 */
.card-body {
  padding: 0 24rpx 28rpx;
  border-top: 2rpx dashed #f1f5f9;
}

/* 输入行 */
.input-row {
  margin-top: 24rpx;
}

.input-label-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.input-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #334155;
}

.input-hint {
  font-size: 22rpx;
  color: #94a3b8;
}

/* 天数输入 */
.days-input-wrapper {
  display: flex;
  align-items: center;
  background-color: #f8fafc;
  border-radius: 16rpx;
  padding: 0 12rpx;
  border: 2rpx solid #e2e8f0;
  width: 100%;
  box-sizing: border-box;
  height: 96rpx;
  gap: 8rpx;
}

.input-minus,
.input-plus {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f1f5f9;
  border-radius: 12rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #64748b;
  transition: all 0.2s ease;
}

.input-minus:active,
.input-plus:active {
  background: #3b82f6;
  color: white;
}

.days-input {
  flex: 1;
  min-width: 80rpx;
  padding: 12rpx 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
  text-align: center;
  line-height: 1.3;
  box-sizing: border-box;
}

.placeholder {
  color: #cbd5e1;
  font-size: 28rpx;
  font-weight: 500;
}

.unit {
  flex-shrink: 0;
  font-size: 28rpx;
  color: #64748b;
  font-weight: 500;
  padding: 0 8rpx 0 4rpx;
  min-width: 40rpx;
  text-align: left;
}

/* 快捷输入按钮 */
.quick-days {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.quick-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  background: linear-gradient(135deg, #f8fafc, #f1f5f9);
  border-radius: 14rpx;
  font-size: 26rpx;
  color: #64748b;
  font-weight: 500;
  transition: all 0.2s ease;
  border: 1rpx solid #e2e8f0;
}

.quick-btn:active {
  background: linear-gradient(135deg, #3b82f6, #1d4ed8);
  color: white;
  border-color: #3b82f6;
  transform: scale(0.96);
}

/* 备注输入 */
.remark-input {
  width: 100%;
  padding: 24rpx;
  background-color: #f8fafc;
  border-radius: 16rpx;
  border: 2rpx solid #e2e8f0;
  font-size: 30rpx;
  color: #1e293b;
  box-sizing: border-box;
  height: 88rpx;
}

.remark-input:focus {
  border-color: #3b82f6;
}

/* 无工地提示 */
.no-project {
  text-align: center;
  padding: 80rpx 40rpx;
  background: #ffffff;
  border-radius: 24rpx;
  border: 2rpx dashed #e2e8f0;
}

.no-project-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.no-project-text {
  display: block;
  font-size: 30rpx;
  color: #64748b;
  font-weight: 600;
}

.no-project-hint {
  display: block;
  font-size: 24rpx;
  color: #94a3b8;
  margin-top: 8rpx;
}

/* 悬浮提交栏 */
.fixed-bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.08);
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 100;
}

.submit-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.summary {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.summary-text {
  font-size: 26rpx;
  color: #64748b;
}

.summary-total {
  font-size: 32rpx;
  color: #1e293b;
  font-weight: 700;
  margin-top: 2rpx;
}

.summary-warning {
  font-size: 24rpx;
  color: #ef4444;
  font-weight: 600;
  margin-top: 4rpx;
  display: block;
}

.submit-btn {
  padding: 28rpx 72rpx;
  border-radius: 50rpx;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
  background: linear-gradient(135deg, #cbd5e1, #94a3b8);
  color: white;
  transition: all 0.3s ease;
}

.submit-btn.active {
  background: linear-gradient(135deg, #3b82f6, #1d4ed8);
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.4);
}

.submit-btn.active:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.3);
}

.submit-btn[disabled] {
  opacity: 0.6;
}
