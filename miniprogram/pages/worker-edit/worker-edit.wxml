<view class="container">
  <view class="header-bg">
    <view class="text-2xl font-black text-white">{{ editMode ? '编辑资料' : '个人资料' }}</view>
    <view class="text-sm text-white opacity-80 mt-2">{{ editMode ? '修改您的个人信息' : '查看您的个人信息' }}</view>
    <view wx:if="{{!editMode}}" class="edit-btn" bindtap="enableEdit">
      <text>编辑</text>
    </view>
  </view>

  <block wx:if="{{!editMode}}">
    <view class="form-card">
      <view class="info-row">
        <view class="info-label">姓名</view>
        <view class="info-value">{{workerInfo.name}}</view>
      </view>
      <view class="info-row">
        <view class="info-label">班组</view>
        <view class="info-value">{{workerInfo.team || '未分配'}}</view>
      </view>
      <view class="info-row">
        <view class="info-label">手机号</view>
        <view class="info-value">{{workerInfo.phone || '未填写'}}</view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="form-card">
      <view class="form-item">
        <view class="form-label">姓名</view>
        <input
          class="form-input"
          value="{{name}}"
          placeholder="请输入姓名"
          bindinput="onNameInput"
        />
      </view>

      <view class="form-item">
        <view class="form-label">班组</view>
        <picker
          bindchange="onTeamChange"
          value="{{teamIndex}}"
          range="{{teams}}"
        >
          <view class="picker-display">
            {{teams[teamIndex]}} <text class="arrow">></text>
          </view>
        </picker>
      </view>

      <view class="form-item">
        <view class="form-label">手机号</view>
        <input
          class="form-input"
          value="{{phone}}"
          type="number"
          maxlength="11"
          placeholder="请输入手机号"
          bindinput="onPhoneInput"
        />
      </view>
    </view>

    <view class="btn-wrap">
      <button
        class="save-btn"
        bindtap="saveInfo"
        disabled="{{saving}}"
      >
        {{saving ? '保存中...' : '保存修改'}}
      </button>
    </view>
  </block>
</view>
