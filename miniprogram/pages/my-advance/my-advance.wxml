<!-- pages/my-advance/my-advance.wxml -->
<view class="container pb-safe">
  <!-- 顶部标题区 -->
  <view class="header">
    <text class="page-title">我的借支</text>
  </view>

  <!-- 筛选条件区 -->
  <view class="filter-section">
    <picker mode="date" fields="month" value="{{currentMonth}}" bindchange="onMonthChange">
      <view class="filter-item">
        <text class="filter-text">{{currentMonth}}</text>
        <text class="dropdown-icon">▼</text>
      </view>
    </picker>
    <view class="filter-item" bindtap="toggleFilter" data-type="all">
      <text class="filter-text">{{filterText}}</text>
      <text class="dropdown-icon">▼</text>
    </view>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-section" wx:if="{{!loading && advances.length > 0}}">
    <view class="stat-card stat-primary">
      <view class="stat-icon">💰</view>
      <view class="stat-info">
        <text class="stat-label">累计借支</text>
        <text class="stat-value">¥{{total}}</text>
      </view>
    </view>
    <view class="stat-card stat-success">
      <view class="stat-icon">📋</view>
      <view class="stat-info">
        <text class="stat-label">借支次数</text>
        <text class="stat-value">{{count}}</text>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-state">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{filteredAdvances.length === 0}}" class="empty-state">
    <view class="empty-icon">📭</view>
    <text class="empty-title">暂无借支记录</text>
    <text class="empty-desc">您还没有任何借支记录</text>
  </view>

  <!-- 借支列表 -->
  <scroll-view wx:else scroll-y class="list-container" bindscrolltolower="onLoadMore" lower-threshold="100">
    <block wx:for="{{groupedAdvances}}" wx:key="month">
      <!-- 月份分组标题 -->
      <view class="month-header">
        <text class="month-text">{{item.month}}</text>
        <text class="month-total">¥{{item.total}}</text>
      </view>

      <!-- 借支卡片 -->
      <view wx:for="{{item.list}}" wx:for-item="advance" wx:key="_id" class="advance-card" bindtap="onCardTap" data-id="{{advance._id}}">
        <view class="card-main">
          <view class="card-left">
            <view class="amount-wrapper">
              <text class="amount-symbol">¥</text>
              <text class="amount-value">{{advance.amount}}</text>
            </view>
            <view class="reason-tag" wx:if="{{advance.reason}}">{{advance.reason}}</view>
            <view class="reason-tag" wx:else>生活费</view>
          </view>
          <view class="card-right">
            <view class="date-text">{{advance.formattedDate}}</view>
            <view class="method-tag" wx:if="{{advance.method}}">{{advance.method}}</view>
          </view>
        </view>
        <view class="card-footer" wx:if="{{advance.remark}}">
          <text class="remark-text">备注：{{advance.remark}}</text>
        </view>
        <!-- 反馈按钮 -->
        <view class="card-actions" catchtap="stopPropagation">
          <button class="btn-question" size="mini" data-id="{{advance._id}}" bindtap="onQuestionTap">
            <text class="btn-icon">❓</text>
            <text>有疑问</text>
          </button>
        </view>
      </view>
    </block>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{hasMore && !loadingMore}}">
      <text>上拉加载更多</text>
    </view>
    <view class="load-more loading-more" wx:if="{{loadingMore}}">
      <view class="loading-spinner-small"></view>
      <text>加载中...</text>
    </view>
    <view class="load-more no-more" wx:if="{{!hasMore && filteredAdvances.length > 0}}">
      <text>— 已加载全部 —</text>
    </view>
  </scroll-view>

  <!-- 筛选弹窗 -->
  <view class="filter-modal" wx:if="{{showFilterModal}}">
    <view class="filter-modal-mask" bindtap="hideFilterModal"></view>
    <view class="filter-modal-content">
      <view class="filter-modal-header">
        <text class="filter-modal-title">筛选类型</text>
        <text class="filter-modal-close" bindtap="hideFilterModal">✕</text>
      </view>
      <view class="filter-options">
        <view class="filter-option {{filterType === 'all' ? 'active' : ''}}" bindtap="selectFilter" data-type="all">
          <text>全部记录</text>
          <text class="filter-option-count" wx:if="{{advances.length > 0}}">{{advances.length}}</text>
        </view>
        <view class="filter-option {{filterType === 'thisMonth' ? 'active' : ''}}" bindtap="selectFilter" data-type="thisMonth">
          <text>本月</text>
          <text class="filter-option-count">{{thisMonthCount}}</text>
        </view>
        <view class="filter-option {{filterType === 'lastMonth' ? 'active' : ''}}" bindtap="selectFilter" data-type="lastMonth">
          <text>上月</text>
          <text class="filter-option-count">{{lastMonthCount}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
